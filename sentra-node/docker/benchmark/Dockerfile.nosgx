# Non-SGX reproducible benchmark image (multi-process secure MNIST in one container).
# SGX/Occlum builds remain in ../SentraNode.dockerfile; this image is the baseline for
# comparing "same code path" with and without TEE once SGX wiring is added.
#
# Build from repository root (parent of `sentra-node/`), e.g.:
#   docker build -f sentra-node/docker/benchmark/Dockerfile.nosgx -t sentra-benchmark:nosgx .

FROM ubuntu:22.04 AS benchmark-nosgx

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=UTC \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TF_CPP_MIN_LOG_LEVEL=2 \
    PYTHONPATH=/workspace/node:/workspace/client

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.10 \
    python3.10-venv \
    python3-pip \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.10 /usr/bin/python3 \
    && ln -sf /usr/bin/python3 /usr/bin/python

WORKDIR /workspace

COPY sentra-node/docker/benchmark/requirements-benchmark.txt /tmp/requirements-benchmark.txt
RUN python3 -m pip install --no-cache-dir --upgrade pip setuptools wheel \
    && python3 -m pip install --no-cache-dir -r /tmp/requirements-benchmark.txt

# Full node tree (imports beyond ml_training/ live here); client for optional distributor mode.
COPY sentra-node/python/node /workspace/node
COPY sentra-node/python/client /workspace/client

WORKDIR /workspace/node
RUN python3 -m pip install --no-cache-dir -e .

COPY sentra-node/docker/benchmark/run_benchmark_from_config.py /usr/local/bin/run_benchmark_from_config.py
RUN chmod +x /usr/local/bin/run_benchmark_from_config.py

COPY sentra-node/docker/benchmark/configs /workspace/benchmark-configs
COPY sentra-node/docker/benchmark/docker-entrypoint-benchmark.sh /usr/local/bin/docker-entrypoint-benchmark.sh
RUN chmod +x /usr/local/bin/docker-entrypoint-benchmark.sh
# Build context from Windows/WSL (drvfs) may copy shell scripts with CRLF; strip so the kernel never sees `bash\r`.
RUN sed -i 's/\r$//' /usr/local/bin/docker-entrypoint-benchmark.sh /usr/local/bin/run_benchmark_from_config.py

WORKDIR /workspace/node
# Invoke via bash so a stray CRLF in the shebang line cannot break container start.
ENTRYPOINT ["/bin/bash", "/usr/local/bin/docker-entrypoint-benchmark.sh"]
# Default: short smoke benchmark (override via docker run / compose command).
CMD ["--config", "/workspace/benchmark-configs/nosgx-quick.yaml"]
