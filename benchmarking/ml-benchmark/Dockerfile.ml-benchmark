# ML benchmark image (Occlum base; full node + client; YAML or raw .py entry).
# Build from repository root:
#   docker build -f benchmarking/ml-benchmark/Dockerfile.ml-benchmark -t sentra-ml-benchmark:latest .
#---------------------------------------------------------------------
ARG BASE_IMAGE=occlum/occlum:0.31.0-ubuntu22.04
FROM $BASE_IMAGE AS sentra-ml-benchmark

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=UTC \
    IS_DOCKERFILE=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TF_CPP_MIN_LOG_LEVEL=2 \
    PYTHONPATH=/workspace/node:/workspace/client

WORKDIR /

RUN apt-get update && apt-get install -y --no-install-recommends jq \
    && rm -rf /var/lib/apt/lists/*

RUN wget -q https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh \
    && bash ./Miniconda3-latest-Linux-x86_64.sh -b -p /miniconda \
    && rm -f Miniconda3-latest-Linux-x86_64.sh
RUN /miniconda/bin/conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/main \
    && /miniconda/bin/conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/r
RUN /miniconda/bin/conda create --prefix /python-occlum -y python=3.10.0 numpy==1.26.4 pyyaml==6.0.3 tensorflow==2.11.0 psutil==5.9.8

#COPY benchmarking/ml-benchmark/requirements-benchmark.txt /tmp/requirements-benchmark.txt
#RUN /python-occlum/bin/pip install --no-cache-dir --upgrade pip setuptools wheel \
#    && /python-occlum/bin/pip install --no-cache-dir -r /tmp/requirements-benchmark.txt

RUN mkdir -p /workspace/node /workspace/client
COPY sentra-node/python/node/ /workspace/node/
COPY sentra-node/python/client/ /workspace/client/

WORKDIR /workspace/node
#RUN /python-occlum/bin/pip install --no-cache-dir -e .

COPY benchmarking/ml-benchmark/run_benchmark_from_config.py /usr/local/bin/run_benchmark_from_config.py
COPY benchmarking/ml-benchmark/configs/ /workspace/benchmark-configs/
COPY benchmarking/ml-benchmark/entrypoint-ml-benchmark.sh /entrypoint.sh
COPY benchmarking/ml-benchmark/enclave_run_script_ml_benchmark.sh /bin/enclave_run_script.sh

COPY ./demonstrator/backend/resources/mnist.npz /root/.keras/datasets/mnist.npz
COPY ./demonstrator/backend/resources/mnist.npz /mnist.npz


#RUN ln -s /python-occlum/bin/python /bin/python3
RUN chmod +x /usr/local/bin/run_benchmark_from_config.py /entrypoint.sh /bin/enclave_run_script.sh \
    && sed -i 's/\r$//' /entrypoint.sh /bin/enclave_run_script.sh /usr/local/bin/run_benchmark_from_config.py

WORKDIR /workspace/node
ENTRYPOINT ["/bin/bash", "/entrypoint.sh"]
CMD ["--config", "/workspace/benchmark-configs/quick.yaml"]
